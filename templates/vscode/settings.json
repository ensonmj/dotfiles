{
    "security.restrictUNCAccess": false,
    "workbench.colorTheme": "Dark+",
    "workbench.colorCustomizations": {
        // "editorInlayHint.foreground": "#fff",
        // "editorInlayHint.background": "#535252",
        // "editor.selectionBackground": "#d1d1c6",
        // "editor.selectionHighlightBackground": "#9c4490"
        "editor.selectionBackground": "#e788ff7c", //Currently SELECTED text
        "editor.selectionHighlightBackground": "#ff00005b", //Same content as selection
        "editor.findMatchBackground": "#00cc44a8", //Current SEARCH MATCH
        "editor.findMatchHighlightBackground": "#ff7b00a1", //Other SEARCH MATCHES
        "numberedBookmarks.lineBackground": "#007700"
    },
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmDelete": false,
    "files.autoSave": "onFocusChange",
    // exclude pattern no need append '**' in the end of folder.
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
    },
    // watcherExclude pattern should append '**' in the end of folder.
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/target/**": true,
        "**/.venv/**": true,
    },
    "search.useIgnoreFiles": false,
    // Inherits all glob patterns from the `files.exclude` setting.
    "search.exclude": {
        "**/target": true
    },
    "editor.minimap.enabled": false,
    "editor.fontFamily": "'Sarasa Term SC Nerd Font', 'FiraMono Nerd Font Mono', Consolas, 'Courier New', monospace",
    "editor.fontSize": 16,
    "editor.renderWhitespace": "trailing",
    "editor.inlayHints.enabled": "on",
    // "editor.formatOnSave": true,
    // "editor.detectIndentation": false,
    "editor.wordWrap": "on",
    "editor.foldingImportsByDefault": true,
    // "editor.lineNumbers": "relative",
    "editor.scrollBeyondLastLine": false,
    "editor.quickSuggestions": {
        "other": true,
        "comments": true,
        "strings": true
    },
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "debug.focusEditorOnBreak": true,
    "debug.console.fontSize": 16,
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.shellIntegration.history": 10000,
    "terminal.integrated.commandsToSkipShell": [
        "-workbench.action.quickOpenView"
    ],
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "vscode-neovim.useWSL": true,
    "vscode-neovim.neovimExecutablePaths.linux": "/usr/bin/nvim",
    "vscode-neovim.neovimInitVimPaths.linux": "~/.config/nvim/init.lua",
    "vscode-neovim.compositeKeys": {
        // "jj" to escape
        "jj": {
            "command": "vscode-neovim.escape",
        },
        // "jk" to escape and save
        "jk": {
            // Use lua to execute any logic
            "command": "vscode-neovim.lua",
            "args": [
                [
                    "local code = require('vscode-neovim')",
                    "code.action('vscode-neovim.escape')",
                    "code.action('workbench.action.files.save')",
                ],
            ],
        },
    },
    "remote.SSH.path": "C:\\Users\\majian\\ssh.bat",
    "remote.SSH.configFile": "\\\\wsl$\\Ubuntu\\home\\dev\\.ssh\\config",
    "remote.SSH.suppressWindowsSshWarning": true,
    "remote.SSH.useCurlAndWgetConfigurationFiles": true,
    "remote.SSH.localServerDownload": "off",
    "remote.restoreForwardedPorts": false,
    "whichkey.delay": 0,
    "whichkey.sortOrder": "alphabetically",
    "C_Cpp.intelliSenseEngine": "disabled",
    "git.autoRepositoryDetection": "openEditors", // avoid loading all repositories
    "git.ignoreLimitWarning": true,
    "gitlens.autolinks": [
        {
            "prefix": "SW-",
            "url": "https://jira.habana-labs.com/browse/SW-<num>"
        }
    ],
    "remote.SSH.remotePlatform": {
        "mj.icx": "linux",
        "habana": "linux",
        "sr228d": "linux",
        "gaudi": "linux",
        "pvc": "linux",
        "bmg": "linux",
        "bmg-dev": "linux",
        "b70": "linux",
        "pvc1": "linux",
        "pvc2": "linux",
        "b70-2": "linux"
    },
    "cmake.showOptionsMovedNotification": false,
    "security.workspace.trust.untrustedFiles": "open",
    "hexeditor.columnWidth": 16,
    "hexeditor.showDecodedText": true,
    "hexeditor.defaultEndianness": "little",
    "hexeditor.inspectorType": "aside",
    "github.copilot.editor.enableAutoCompletions": true,
    "gitlens.views.commitDetails.files.layout": "tree",
    "cmake.configureOnOpen": false,
    "[python]": {
        "diffEditor.ignoreTrimWhitespace": false,
        "gitlens.codeLens.symbolScopes": [
            "!Module"
        ],
        "editor.formatOnType": true,
        "editor.wordBasedSuggestions": "off"
    },
    "vs-kubernetes": {
        "vs-kubernetes.kubeconfig": {
            "nodeType": "context",
            "nodeCategory": "kubernetes-explorer-node",
            "contextName": "hldc02",
            "kubectlContext": {
                "clusterName": "hldc02",
                "contextName": "hldc02",
                "userName": "hldc02",
                "active": false
            }
        },
        "vscode-kubernetes.helm-path-linux": "/home/jianma/.local/state/vs-kubernetes/tools/helm/linux-amd64/helm"
    },
    "yaml.schemas": {
        "https://raw.githubusercontent.com/dcermak/vscode-rke-cluster-config/main/schemas/cluster.yml.json": [
            "cluster.yml",
            "cluster.yaml"
        ]
    },
    "git.openRepositoryInParentFolders": "never",
    "gitlens.advanced.fileHistoryShowMergeCommits": true,
    "github.copilot.advanced": {
        "authProvider": "github"
    },
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "remote.autoForwardPortsSource": "hybrid",
    "notebook.lineNumbers": "on",
    "chat.mcp.gallery.enabled": true,
    "chat.viewSessions.orientation": "stacked",
    "chat.tools.urls.autoApprove": {
        "https://code.visualstudio.com": true,
        "https://github.com/microsoft/vscode/wiki/*": true,
        "https://github.com": {
            "approveRequest": false,
            "approveResponse": true
        },
        "https://raw.githubusercontent.com": {
            "approveRequest": false,
            "approveResponse": true
        },
        "https://learn.chatgpt.com": {
            "approveRequest": true,
            "approveResponse": false
        }
    },
}