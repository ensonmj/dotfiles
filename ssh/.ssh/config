Host *
    ControlMaster auto
    ControlPath ~/.ssh/master-%r@%h:%p
    ControlPersist 1m
    # ControlPersist yes
    ServerAliveInterval 60
    # ServerAliveCountMax 10
    ForwardAgent yes
    # IdentityAgent ~/.ssh/ssh_auth_sock
Host github.com
    HostName github.com
    #ProxyCommand connect -a none -S example.com:1080 %h %p
    #ProxyCommand nc -X 5 -x example.com:1080 %h %p
    #ProxyCommand nc -X connect -x example.com:7890 %h %p
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
